# Backend env example for commentator integration
# Copy this file to .env and update values.

PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017
# DB name is fixed to "pubgbackend" in src/constants.js (no DB_NAME env needed)

# Frontend origin allowed for both REST and Socket.IO CORS
CORS_ORIGIN=http://localhost:3000

# Tournament Squad Size Configuration
# Supported values: 2 (duo mode), 4 (squad mode)
# Default: 4
# Controls player count per team across all tournament logic
TEAM_SQUAD_SIZE=4

# Debug Mode
# Set to true to enable debug logging for elimination and scoring events
# Default: false
DEBUG_MODE=false

# Admin Authentication
# Secret used to sign admin session tokens. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# Initial admin account (created automatically on first startup if no admin exists)
# If ADMIN_PASSWORD is omitted, a random password is generated and printed once in the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional: public base URL used for locally-served team logos when Cloudinary is not configured
# PUBLIC_BASE_URL=http://localhost:8000

# Optional: AI vision extraction for screenshots (hybrid with Tesseract OCR).
# Leave AI_VISION_PROVIDER unset/off to use Tesseract OCR only (default).
# Providers: ollama (local, no key) | gemini | groq | openrouter
# AI_VISION_PROVIDER accepts a comma-separated fallback chain and tries them
# in order: e.g. AI_VISION_PROVIDER=groq,gemini
# API keys may ALSO be comma-separated lists; they rotate when one hits its
# free daily quota, so adding a second key keeps AI extraction alive.
# Any provider failure falls back to Tesseract OCR (flagged in the admin UI).
# Groq vision model on the free tier: qwen/qwen3.8-27b
# AI_VISION_PROVIDER=off
# AI_VISION_MODEL=
# AI_VISION_TIMEOUT_MS=30000
# AI_VISION_RETRIES=4
# AI_VISION_MIN_INTERVAL_MS=20000
# AI_VISION_MAX_WAIT_MS=8000
# AI_VISION_COOLDOWN_MS=120000
# AI_VISION_MAX_DIMENSION=1280
# GROQ_REASONING_EFFORT=none
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional: Cloudinary (team logo uploads). If omitted, logos are served locally from /public/temp.
# CLOUD_NAME=
# CLOUD_API_KEY=
# CLOUD_API_SECRET=
