{
  "name": "pubg-backend",
  "version": "1.0.0",
  "description": "this is backend for handling pubg tournament",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon -r dotenv/config src/index.js --host 0.0.0.0",
    "seed:sample": "node -r dotenv/config src/utils/seedSample.js",
    "migrate:tournaments": "node -r dotenv/config src/utils/migrateTournaments.js",
    "recompute:totals": "node -r dotenv/config src/utils/recomputeTotals.js",
    "test": "node --test src/utils/rosterParser.test.js src/utils/aiVision.test.js src/utils/pointsPreview.test.js"
  },
  "keywords": [
    "backend",
    "hdc",
    "tournament",
    "pubg"
  ],
  "author": "pramod laha",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "socket.io": "^4.8.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
